<h1>Edit Profile</h1>

<%= form_for(@user, html: { mulipart: true }) do |f| %>
    <%= f.label :first_name %>
    <%= f.text_field :first_name %>
    <%= f.submit "Save Change" %>
    <%= f.label :last_name %>
    <%= f.text_field :last_name %>
    <%= f.submit "Save Change" %>
    <%= f.label :avatar %>
    <%= f.file_field :avatar %>
    <%= f.submit "Save Change" %>
    

<% end %>